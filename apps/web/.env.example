# URL do projeto Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon/publishable key — segura pra expor no frontend, o acesso real
# é controlado pelas políticas de RLS no banco.
VITE_SUPABASE_ANON_KEY=

# URL do backend Node.js (apps/api) em desenvolvimento
VITE_API_URL=http://localhost:3333
