# URL do projeto Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key — tem acesso total, ignora RLS.
# NUNCA exponha essa chave no frontend, só o backend deve conhecê-la.
SUPABASE_SERVICE_ROLE_KEY=

# Porta em que a API sobe localmente
PORT=3333

# Origem(ns) permitida(s) para CORS (o dev server do web app)
WEB_ORIGIN=http://localhost:5173
